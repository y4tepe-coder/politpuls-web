# Politpuls-Video — lokale Secrets/Konfiguration.
# Kopiere diese Datei nach `.env` (gitignoriert) und trage echte Werte ein.
# NIE echte Keys committen — `.env` und `.env.*` stehen in .gitignore.

# --- Erzähler-Stimme (eine reicht; Reihenfolge: ElevenLabs > OpenAI > macOS say) ---
# ElevenLabs (beste Qualität, liefert wortsynchrone Untertitel-Timestamps):
ELEVENLABS_API_KEY=
# Optional: Stimme (Default = multilingual "Rachel"):
ELEVENLABS_VOICE_ID=
# Sprechtempo 0.7–1.2 (>1 = schneller). Default 1.0 = natürliches Tempo.
ELEVENLABS_SPEED=1.0

# OpenAI-TTS (Fallback, ohne Wort-Timestamps):
OPENAI_API_KEY=
# OPENAI_TTS_VOICE=alloy
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# --- B-Roll-Clips (optional) ---
# Pixabay Videos-API-Key. Wird von auto-source.mjs gelesen, um für 1–2
# Szenen-Beats einen CC-Clip statt eines Standbilds zu holen. Fehlt der Key,
# läuft alles weiter mit Bildern (Clips sind reine Würze).
# Pixabay Content License: kommerzielle Nutzung ohne Namensnennung erlaubt.
# Key holen: https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Optional: wie viele Beats höchstens einen Clip bekommen (Default 2):
# MAX_VIDEO_CLIPS=2

# --- Upload (publish-video.mjs) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
